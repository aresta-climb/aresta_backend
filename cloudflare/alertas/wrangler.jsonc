{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aresta-alertas-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "vars": {
    "CANAL_ALERTAS_ATIVO": "discord",
    "EMAIL_DESTINATARIO_FALLBACK": "contato@arestaclimb.com",
    "EMAIL_REMETENTE_ALERTA": "alerta@login.arestaclimb.com",
    "NTFY_BASE_URL": "https://ntfy.sh",
    "WAHA_SESSION": "default"
  },
  "kv_namespaces": [
    {
      "binding": "FILA_RETENTATIVAS_ALERTAS",
      "id": "aefdb70a72d7490590aa081f4da2a596"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "alertas.arestaclimb.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
