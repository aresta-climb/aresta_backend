{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aresta-catalogo-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aresta-catalogo",
      "database_id": "7368d2d3-c69b-4cd5-9e2a-5ecc0ee3c830"
    }
  ],
  "routes": [
    {
      "pattern": "catalogo.arestaclimb.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  }
}
