{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aresta-catalogo-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aresta-catalogo"
    }
  ],
  "routes": [
    {
      "pattern": "catalogo.arestaclimb.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
