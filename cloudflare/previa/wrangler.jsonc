{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aresta-previa-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSAO_DO",
        "class_name": "SessaoDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessaoDurableObject"]
    }
  ],
  "routes": [
    {
      "pattern": "previa.arestaclimb.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
